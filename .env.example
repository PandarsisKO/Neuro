# Copy to .env and fill in. Never commit .env.

# Required for Ask / MCP `ask` (answers with citations, optional web search)
ANTHROPIC_API_KEY=

# Required for semantic search (embeddings) and audio transcription (Whisper).
# Without it the tool still works with keyword search + YouTube captions only.
OPENAI_API_KEY=

# Shared secret for the web app login, API Bearer token and MCP URL (/mcp/<token>).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(24))"
NEUROSEARCH_APP_TOKEN=

# Where the SQLite database and temp media live
NEUROSEARCH_DATA_DIR=./data

# Optional
# NEUROSEARCH_ANSWER_MODEL=claude-sonnet-4-6   # fallback labels only; chat runs contracts.HELD_MODEL (claude-sonnet-5)
# NEUROSEARCH_EMBEDDING_MODEL=text-embedding-3-small
# NEUROSEARCH_TRANSCRIBE_MODEL=whisper-1
# NEUROSEARCH_CAPTION_LANGS=en,en-US,en-GB
# NEUROSEARCH_COOKIES_FILE=./data/cookies.txt   # Netscape-format cookies for YouTube/Instagram (see README)
# NEUROSEARCH_ALLOW_TRANSCRIPTION=true
# NEUROSEARCH_MAX_TRANSCRIBE_MINUTES=240
# NEUROSEARCH_WORKERS=2
# NEUROSEARCH_DAILY_BUDGET_USD=5        # background queue pauses when reached (0 = no limit)
# NEUROSEARCH_MONTHLY_BUDGET_USD=50
# NEUROSEARCH_SINCE_YEARS=2            # channels/playlists: only videos newer than this (0 = all)
# NEUROSEARCH_MAX_VIDEOS=20            # channels/playlists: cap per pull (0 = no cap); code default is 20
# NEUROSEARCH_YT_DELAY=4              # seconds between YouTube fetches (randomised); raise for big channels
# NEUROSEARCH_YT_BACKOFF_MINUTES=20   # pause after a YouTube bot-check
# NEUROSEARCH_CHUNK_SECONDS=60
# NEUROSEARCH_CHUNK_OVERLAP=10
# NEUROSEARCH_SHORT_FORM_SECONDS=150

# Reddit's official API (optional, 0.32.2). Reddit refuses every non-browser reader since 2026-06-30; with a Reddit
# "script" app's credentials (https://www.reddit.com/prefs/apps → create app → type "script") the app can search
# subreddits and read threads through OAuth (app-only, read-only public data; free personal tier, 100 requests/min).
# Without them, threads still arrive through the browser extension ("Send this page" on a thread) — search does not.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# L1 Local-First AI (0.38.0): route local-capable AI tasks (findings, ranking, profiles, claims, discovery, plan updates)
# through Claude Code on this machine. A local failure waits locally unless the separate paid fallback switch
# below is explicitly enabled. Off (cloud) until you turn it on.
# NEUROSEARCH_AI_PROFILE=local
# NEUROSEARCH_LOCAL_AI_WORKERS=2
# NEUROSEARCH_CLAUDE_CODE_BIN=claude
# NEUROSEARCH_CLAUDE_CODE_MODEL=

# --- Research catalogues (scholar.py, both free) -------------------------------------------------
# Crossref needs no account. An email here only earns the polite pool's higher limits
# (10 req/s single, 3 req/s list) instead of the public pool's (5 and 1).
NEUROSEARCH_SCHOLAR_EMAIL=
# OpenAlex has REQUIRED a free key since 2026-02-13 — unkeyed callers get 100 credits, then HTTP 409.
# Sign up at openalex.org; the free tier is 100,000 credits/day (a list query costs 10).
# Without it, Neuro Search simply reports OpenAlex as unavailable and uses Crossref alone.
OPENALEX_API_KEY=

# Explicit opt-in only: local AI errors otherwise wait without buying paid API work.
NEUROSEARCH_LOCAL_API_FALLBACK=false

# --- Production model choices that live HERE, not in code (2026-09-21) --------------------------------
# findings.extract runs on Haiku in production (E5 cohort 2026-09-14; L-06/L-07 2026-09-20: 100%/100% kept,
# $0.0006 vs $0.0014 per kept finding). contracts.py still says Sonnet 5; without this line you pay 2.3x.
NEUROSEARCH_TASK_MODEL_FINDINGS_EXTRACT=claude-haiku-4-5
# Any other task can be overridden the same way: NEUROSEARCH_TASK_MODEL_<TASK_NAME_UPPERCASED_WITH_UNDERSCORES>

# --- YouTube Data API v3 (optional, 2026-09-20) --------------------------------------------------------
# Enriches channel/playlist/search listings with description, publish date, duration, views and captions-exist
# (media._enrich_youtube, first 600 entries, empty fields only). 1 quota unit per 50 videos of the free 10,000/day.
# Without it, listings are exactly what yt-dlp's flat extraction gives (no descriptions -> weaker relevance ranking).
# Create at https://console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key.
NEUROSEARCH_YOUTUBE_API_KEY=

# --- FRED (optional; PARKED 2026-09-21 — the client exists but nothing consumes it yet) ----------------
# NEUROSEARCH_FRED_API_KEY=

# --- Nightly envelope (all off unless set; dollars are ceilings per night) --------------------------------
# NEUROSEARCH_T4_NIGHTLY_BUDGET_USD=0
# NEUROSEARCH_T4_NIGHTLY_HOUR=2
# NEUROSEARCH_T5_NIGHTLY_BUDGET_USD=0
# NEUROSEARCH_RESEARCH_REFRESH_NIGHTLY_BUDGET_USD=0
# NEUROSEARCH_CR8B_ENABLED=false            # selective acquisition for open Evidence Targets (CR8b-gate not yet run)
# NEUROSEARCH_MORNING_REPORT_NEEDS_ME=true  # Morning Report v2 "What needs me?" (L-52, on since 2026-09-20)

# --- Rarely changed -------------------------------------------------------------------------------------
# NEUROSEARCH_API_AI_WORKERS=3        # paid AI worker slots
# NEUROSEARCH_AUTO_SUGGEST=true
# NEUROSEARCH_PRICES='{"claude-sonnet-4-6":[3,15]}'   # override usage.PRICES when rates change
# NEUROSEARCH_FAKE_AI=1               # tests/evals only: content-aware fake models, no network
# Experiments, all measured OFF (HARDENING.md): NEUROSEARCH_PLANNER_V3, NEUROSEARCH_RETRIEVAL_RERANK,
# NEUROSEARCH_FINDINGS_PREFILTER, NEUROSEARCH_CHAT_TAIL_BREAKPOINT. Do not enable without a new measurement.
